rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function allowedEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'rupesh.mudlar@cognizantchemical.com',
          'indra@cognizantchemical.com',
          'production@cognizantchemical.com',
          'qa@cognizantchemical.com',
          'anzarsayyed02@gmail.com'
        ];
    }
    function activeUser() {
      return allowedEmail() && exists(/databases/$(database)/documents/companies/ccpl/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/ccpl/users/$(request.auth.uid)).data.active == true;
    }
    function admin() { return activeUser() && request.auth.token.email == 'rupesh.mudlar@cognizantchemical.com'; }
    function notResetting() {
      return !exists(/databases/$(database)/documents/companies/ccpl/system/maintenance)
        || get(/databases/$(database)/documents/companies/ccpl/system/maintenance).data.resetInProgress != true;
    }
    match /companies/ccpl/users/{uid} {
      allow read: if allowedEmail() && (uid == request.auth.uid || admin());
      allow create: if allowedEmail() && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.role == (request.auth.token.email == 'rupesh.mudlar@cognizantchemical.com' ? 'admin' : 'staff');
      allow update, delete: if admin();
    }
    match /companies/ccpl/stock/{docId} {
      allow read: if activeUser();
      allow create, update: if (activeUser() && notResetting()) || admin();
      allow delete: if admin();
    }
    match /companies/ccpl/batches/{batchId} {
      allow read: if activeUser();
      allow create, update: if activeUser() && notResetting();
      allow delete: if admin();
    }
    match /companies/ccpl/sales/{saleId} {
      allow read: if activeUser();
      allow create: if activeUser() && notResetting();
      allow update: if admin() && notResetting();
      allow delete: if admin();
    }
    match /companies/ccpl/activity/{eventId} {
      allow read: if activeUser();
      allow create: if (activeUser() && notResetting()) || admin();
      allow update: if admin() && notResetting();
      allow delete: if admin();
    }
    match /companies/ccpl/settings/{settingId} {
      allow read: if activeUser();
      allow write: if admin();
    }
    match /companies/ccpl/system/{docId} {
      allow read: if activeUser();
      allow write: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
